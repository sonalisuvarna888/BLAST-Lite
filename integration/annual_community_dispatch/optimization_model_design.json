    "hourly_upper_bound_fraction": 1.15,
    "daily_energy_preserved_per_household": true,
    "daily_energy_preservation_scope": "Each implemented 24-hour day",
    "inconvenience_penalty": "Quadratic normalized deviation from baseline",
    "inconvenience_weight": 0.035
  },
  "battery": {
    "nominal_capacity_kwh": 60.0,
    "initial_state_of_health": 0.7,
    "available_capacity_kwh": 42.0,
    "minimum_soc_fraction": 0.1,
    "maximum_soc_fraction": 0.9,
    "minimum_soc_kwh": 4.2,
    "maximum_soc_kwh": 37.8,
    "initial_soc_fraction": 0.5,
    "initial_soc_kwh": 21.0,
    "maximum_charge_kw": 12.0,
    "maximum_discharge_kw": 12.0,
    "round_trip_efficiency": 0.85,
    "charge_efficiency": "sqrt(0.85)",
    "discharge_efficiency": "sqrt(0.85)",
    "throughput_penalty_per_kwh": 0.015,
